# Database
DATABASE_URL=postgresql://prcoverage:prcoverage@localhost:5432/prcoverage?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# API
API_PORT=3000
WEBHOOK_SECRET=change-me-to-a-random-secret

# GitHub (choose one auth method)
GITHUB_AUTH_MODE=pat
GITHUB_PAT=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=

# LLM
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# Test generation only (defaults: gpt-4o / claude-sonnet-4-20250514 / local-model)
TEST_GENERATION_MODEL=gpt-4o

# Worker
# Local dev: run `pnpm setup:worker-deps` from coverage-service/ then set:
DIFF_COVER_BIN=.venv-tools/bin/diff-cover
WORKER_CONCURRENCY=2
WORK_DIR=/tmp/pr-coverage-runs
EXECUTION_TIMEOUT_MS=3600000
JOB_LOCK_DURATION_MS=3600000
JOB_STALLED_INTERVAL_MS=120000
JOB_MAX_STALLED_COUNT=5
# Set true for local dev with tsx watch; leave false in Docker/production
WORKER_FORCE_SHUTDOWN=false
MAX_MEMORY_MB=2048
MAX_CPU_CORES=2

# Coverage workflow / optimization
# TARGET_DIFF_COVERAGE accepts 80 (percent) or 0.8 (fraction). Falls back to TEST_THRESHOLD.
TARGET_DIFF_COVERAGE=80
TEST_THRESHOLD=80
MAX_OPTIMIZATION_ITERATIONS=8
MAX_GENERATION_ATTEMPTS=3
MAX_REPAIR_ATTEMPTS=3
MIN_COVERAGE_GAIN=1
ENABLE_REPAIR_LOOP=true
MAX_FILES_PER_ITERATION=10
