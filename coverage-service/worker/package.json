{
  "name": "@openreview/coverage-worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "start:dev": "tsx watch --clear-screen=false --exclude '**/dist/**' --exclude '**/node_modules/**' --exclude '**/.git/**' src/main.ts",
    "start:stable": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "setup:deps": "sh scripts/setup-deps.sh"
  },
  "dependencies": {
    "@openreview/coverage-lib": "workspace:*",
    "@prisma/client": "^6.1.0",
    "bullmq": "^5.34.3",
    "dotenv": "^17.3.1",
    "ioredis": "^5.4.2"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "prisma": "^6.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
