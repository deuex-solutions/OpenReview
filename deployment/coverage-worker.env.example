DATABASE_URL=postgresql://prcoverage:prcoverage@postgres:5432/prcoverage?schema=public
REDIS_URL=redis://redis:6379
GITHUB_AUTH_MODE=pat
GITHUB_PAT=
LLM_PROVIDER=openai
OPENAI_API_KEY=
TEST_GENERATION_MODEL=gpt-4o
NODE_ENV=production
WORKER_CONCURRENCY=2
WORK_DIR=/tmp/pr-coverage-runs
EXECUTION_TIMEOUT_MS=3600000
JOB_LOCK_DURATION_MS=3600000
JOB_STALLED_INTERVAL_MS=120000
JOB_MAX_STALLED_COUNT=5
WORKER_FORCE_SHUTDOWN=false
DIFF_COVER_BIN=diff-cover
PYTHON_BIN=python3
TEST_THRESHOLD=80
MAX_GENERATION_ATTEMPTS=3
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
MAX_MEMORY_MB=2048
MAX_CPU_CORES=2
