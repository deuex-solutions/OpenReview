{
  "name": "openreview",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Open-source agentic code review tool — AI-powered bug detection, sandboxed execution, codebase-aware chat, full GitHub sync",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "build": "pnpm coverage:db:generate && pnpm -r build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm coverage:db:generate && pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "review": "node cli/dist/main.mjs review",
    "coverage:build": "pnpm --filter @openreview/coverage-lib build && pnpm --filter @openreview/coverage-api run db:generate && pnpm --filter @openreview/coverage-api build && pnpm --filter @openreview/coverage-worker build",
    "coverage:db:generate": "pnpm --filter @openreview/coverage-api run db:generate",
    "coverage:db:migrate": "pnpm --filter @openreview/coverage-api run db:migrate",
    "coverage:db:push": "pnpm --filter @openreview/coverage-api run db:push",
    "coverage:dev:api": "pnpm --filter @openreview/coverage-api start:dev",
    "coverage:dev:worker": "pnpm --filter @openreview/coverage-worker start:dev",
    "coverage:setup:worker-deps": "pnpm --filter @openreview/coverage-worker setup:deps"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "msgpackr-extract",
      "prisma",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@langchain/anthropic": "^0.3.34",
    "@langchain/core": "^0.3.80",
    "@langchain/google-genai": "^0.2.18",
    "@langchain/langgraph": "^0.2.74",
    "@langchain/openai": "^0.4.9",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.0",
    "axios": "^1.13.6",
    "eslint": "^10.0.3",
    "eslint-plugin-import-x": "^4.16.2",
    "prettier": "^3.8.1",
    "tsdown": "^0.21.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vitest": "^4.1.0",
    "zod": "^4.3.6"
  }
}
