# =============================================================================
# OpenReview Service — Environment Configuration
# =============================================================================
# This file ONLY documents service-specific env vars.
# All review-engine vars (OPENAI_API_KEY, MAIN_MODEL, etc.) come from the
# project-root .env loaded by @openreview/core.

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------

# Secret used to verify GitHub webhook deliveries (X-Hub-Signature-256).
# Generate with: openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# GitHub Personal Access Token used by the service to fetch PRs and post
# review comments. Reuses GITHUB_PAT from the root .env if not set here.
# Scopes needed for private repos: repo
# For public-repo-only operation, no scopes are required.
# GITHUB_PAT=

# Redis connection URL used by BullMQ.
# Examples:
#   redis://localhost:6379
#   redis://:password@redis.example.com:6379/0
#   rediss://default:<password>@<host>:<port>   (TLS)
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Optional — server
# -----------------------------------------------------------------------------

# HTTP port the webhook receiver binds to.
PORT=3000

# Host interface the webhook receiver binds to.
HOST=0.0.0.0

# Maximum size accepted for a webhook payload. GitHub caps deliveries at 25 MB.
MAX_PAYLOAD_BYTES=26214400

# Log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# NODE_ENV controls log formatting (production -> JSON, development -> pretty).
NODE_ENV=production

# -----------------------------------------------------------------------------
# Optional — worker
# -----------------------------------------------------------------------------

# Number of jobs the worker processes concurrently.
WORKER_CONCURRENCY=4

# How many times a failed job is retried before being declared dead.
JOB_MAX_ATTEMPTS=3

# Backoff delay (ms) for retried jobs. Exponential backoff is applied.
JOB_BACKOFF_MS=5000

# How many completed/failed job records to retain for inspection.
JOB_KEEP_COMPLETED=200
JOB_KEEP_FAILED=500

# -----------------------------------------------------------------------------
# Optional — Coverage Service integration (opt-in)
# -----------------------------------------------------------------------------
# When enabled, every accepted PR also enqueues a `coverage-analysis` job.
# The worker calls the Coverage Service (PR diff coverage + LLM unit-test
# generation) in three steps:
#   1. POST /repositories               (auto-register the repo if unseen)
#   2. POST /repositories/:id/analyze   (returns prRunId)
#   3. GET  /pr-runs/:id                (polled until COMPLETED / FAILED)
# On completion, a stacked PR is opened with the generated test files,
# targeting the original PR's feature branch, and a coverage-delta comment
# is posted on the original PR.

# Master switch. Set to "true" to turn the pipeline on.
COVERAGE_SERVICE_ENABLED=false

# Required when COVERAGE_SERVICE_ENABLED=true.
# Examples:
#   http://localhost:3000          (local dev — matches coverage-service/docker-compose)
#   https://coverage.internal      (cluster service)
COVERAGE_SERVICE_URL=

# Optional shared secret. Sent as `x-api-key`. Leave empty for unauthenticated
# private-network deployments.
COVERAGE_SERVICE_API_KEY=

# Polling cadence. The client doubles the wait between polls (capped at 30s)
# and gives up after the timeout. Coverage runs include clone + install +
# coverage + LLM + re-run, so allow a generous timeout.
COVERAGE_SERVICE_POLL_INTERVAL_MS=5000
COVERAGE_SERVICE_POLL_TIMEOUT_MS=1800000

# Branch prefix for the stacked test PR. The full ref is
# `<prefix>/pr-<N>` (e.g. `openreview/tests/pr-42`).
COVERAGE_SERVICE_BRANCH_PREFIX=openreview/tests

# Defaults sent on auto-registration (POST /repositories). Leave empty to
# inherit the coverage service's own defaults. Override per-repo by hitting
# the coverage service /repositories endpoint directly.
COVERAGE_SERVICE_DEFAULT_BRANCH=main
COVERAGE_SERVICE_COVERAGE_COMMAND=
COVERAGE_SERVICE_TEST_COMMAND=
COVERAGE_SERVICE_INSTALL_COMMAND=
